# 五子棋游戏环境配置

# ==================== 后端配置 ====================
# 运行环境
NODE_ENV=production

# 后端服务端口
PORT=5001

# ==================== Redis 配置 ====================
# 如果服务器已有 Redis，填写对应地址
# 如果使用 Docker Compose 内置 Redis，保持默认值即可
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 如果使用外部 Redis，取消注释并设置：
# REDIS_HOST=your-redis-host.example.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password

# ==================== 前端配置 ====================
# 前端服务端口
FRONTEND_PORT=8080

# ==================== CORS 配置 ====================
# 允许的前端域名，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# 生产环境示例：
# ALLOWED_ORIGINS=https://gobang.example.com

# ==================== 日志配置 ====================
# 日志级别：error, warn, info, debug
LOG_LEVEL=info

# ==================== Redis 外部访问端口 ====================
# 如果需要从外部访问 Redis（不推荐生产环境开放）
REDIS_EXTERNAL_PORT=6379
